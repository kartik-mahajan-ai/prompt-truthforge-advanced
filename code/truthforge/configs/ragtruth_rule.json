{
  "seed": 20260920,
  "dataset": "ragtruth",
  "split": "test",
  "limit": null,
  "out_dir": "runs",
  "run_name": "ragtruth_rule",
  "retrieval": {
    "top_k": 5,
    "bm25_k": 20,
    "dense_k": 20,
